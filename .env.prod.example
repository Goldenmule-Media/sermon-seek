# Production environment — copy to .env.prod on the operator's laptop.
# The deploy script (deploy.sh, C23) scp's this file to
# /opt/sermon-search/repo/.env on each deploy.
#
# NEVER commit a populated .env.prod to the repo.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=sermon_search
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sermon_search

# Must point to the postgres service (container name) inside the compose network.
DATABASE_URL=postgres://sermon_search:changeme@postgres:5432/sermon_search

# ── API ─────────────────────────────────────────────────────────────────────
# Required — guards all admin/ingestion routes.
ADMIN_API_KEY=

# Required — used to fetch channel/playlist/video metadata from YouTube.
YOUTUBE_API_KEY=

# Required for semantic search (mode=semantic|hybrid) and LLM enrichment.
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# ENRICHMENT_MODEL=gpt-4o-mini

# Allow the web origin to call the API (same-origin in prod via Caddy, but set
# explicitly for correctness).
CORS_ORIGIN=https://sermonseek.ai

# ── Web ──────────────────────────────────────────────────────────────────────
# Baked into the Next.js client bundle at image build time.
# Browser fetches go to https://sermonseek.ai/v1/... and Caddy proxies them.
NEXT_PUBLIC_API_URL=https://sermonseek.ai

# ── Worker ───────────────────────────────────────────────────────────────────
# Absolute path inside the worker container — bind-mounted from the host's
# /opt/sermon-search/data/cache so it survives container teardown.
CACHE_DIR=/var/lib/sermon-search/cache

# Override the reference video exercised by the daily caption smoke-test.
# SMOKE_TEST_VIDEO_ID=19l5OI_8ljQ
# SMOKE_TEST_MIN_SEGMENTS=50
# SMOKE_TEST_MIN_WORDS=500
# SMOKE_TEST_MIN_COVERAGE_PCT=60

# Church slug used by systemd jobs (view-stats, rss-poll) for the --church flag.
# Must match a row in the churches table. For Jubilee: jubileestl.
CHURCH_SLUG=jubileestl

# YouTube *channel ID* (UCxxxxxx format) for the hourly RSS poll.
# Distinct from the channel handle (@JubileeChurchSTL). Find it at:
#   https://www.youtube.com/@JubileeChurchSTL/about → share → copy channel ID
# Or: yt-dlp --print channel_id "https://www.youtube.com/@JubileeChurchSTL"
RSS_CHANNEL_ID=

# ── Backups + cron (C24) ─────────────────────────────────────────────────────
# Number of nightly pg_dump files to retain in /opt/sermon-search/backups/.
# Older files are pruned automatically after each successful dump.
BACKUP_RETENTION_DAYS=14

# Incoming webhook URL for smoke-test / job failure alerts (Slack, Discord, etc.).
# Leave blank to disable alerting. The webhook receives a JSON {"text": "..."} payload.
ALERT_WEBHOOK_URL=

# ── Proxy (Caddy) ────────────────────────────────────────────────────────────
# Domain Caddy binds to and obtains a TLS certificate for.
DOMAIN=sermonseek.ai

# Email address registered with Let's Encrypt for certificate notifications.
ACME_EMAIL=you@example.com
