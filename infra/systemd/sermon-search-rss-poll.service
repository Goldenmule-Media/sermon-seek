# NOTE: This unit is NOT enabled by deploy.sh by default.
# It will be re-enabled once per-church recurring-job config lands (see follow-up
# card): add rss_channel_id / recurring_jobs_enabled columns to the churches table,
# rework the worker CLI to enumerate eligible churches from the DB, then restore
# this unit and sermon-search-view-stats to the deploy.sh timer enable loop.
[Unit]
Description=Sermon-Search hourly RSS poll for new uploads
Documentation=https://github.com/Goldenmule-Media/sermon-search/blob/main/infra/README.md
After=docker.service
Requires=docker.service
OnFailure=sermon-search-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sermon-search/repo
EnvironmentFile=/opt/sermon-search/repo/.env
ExecStart=/usr/bin/docker compose -f /opt/sermon-search/repo/infra/docker-compose.prod.yml \
  --project-directory /opt/sermon-search/repo \
  exec -T worker \
  node /app/apps/worker/dist/cli/run.js \
  --rss-poll
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sermon-search-rss-poll
