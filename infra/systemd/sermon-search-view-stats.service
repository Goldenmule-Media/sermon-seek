[Unit]
Description=Sermon-Search daily view-stats refresh
Documentation=https://github.com/Goldenmule-Media/sermon-search/blob/main/infra/README.md
After=docker.service
Requires=docker.service
OnFailure=sermon-search-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sermon-search/repo
EnvironmentFile=/opt/sermon-search/repo/.env
ExecStart=/usr/bin/docker compose -f /opt/sermon-search/repo/infra/docker-compose.prod.yml \
  --project-directory /opt/sermon-search/repo \
  exec -T worker \
  node /app/apps/worker/dist/cli/run.js \
  --church ${CHURCH_SLUG} --view-stats
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sermon-search-view-stats
