{
  "name": "@sermon-search/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "eval": "tsx --env-file=../../.env eval/score.ts",
    "perf": "tsx --env-file=../../.env eval/perf.ts",
    "admin:grant": "tsx --env-file=../../.env src/cli/admin-grant.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@sermon-search/db": "workspace:*",
    "@sermon-search/embeddings": "workspace:*",
    "@sermon-search/notifications": "workspace:*",
    "@sermon-search/scripture": "workspace:*",
    "@sermon-search/types": "workspace:*",
    "@sermon-search/worker": "workspace:*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^10.3.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.3",
    "kysely": "^0.27.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
