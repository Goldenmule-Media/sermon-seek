{
  "name": "@sermon-search/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sermon-admin": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
