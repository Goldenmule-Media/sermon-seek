{
  "name": "@sermon-search/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "dist": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "worker:run": "tsx --env-file=../../.env src/cli/run.ts",
    "enrich:preview": "tsx --env-file=../../.env src/cli/enrich-preview.ts",
    "calibrate-token-cap": "tsx --env-file=../../.env src/requests/calibrate-token-cap.ts"
  },
  "dependencies": {
    "@sermon-search/db": "workspace:*",
    "js-tiktoken": "^1.0.16",
    "@sermon-search/embeddings": "workspace:*",
    "@sermon-search/scripture": "workspace:*",
    "@sermon-search/types": "workspace:*",
    "kysely": "^0.27.4",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
