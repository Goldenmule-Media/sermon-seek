{
  "name": "@sermon-search/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "migrate": "tsx --env-file=../../.env src/cli/migrate.ts",
    "reset": "tsx --env-file=../../.env src/cli/reset.ts",
    "psql": "tsx --env-file=../../.env src/cli/psql.ts",
    "seed": "tsx --env-file=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@sermon-search/scripture": "workspace:*",
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
