# YouTube Data API v3 key — used by the worker to fetch sermon metadata.
YOUTUBE_API_KEY=

# Postgres connection string for local development (matches docker-compose default in C2).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sermon_search

# Separate throwaway database for worker integration tests. Must differ from DATABASE_URL.
# Integration tests are silently skipped when this is unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sermon_search_test

# Local on-disk cache directory for worker artifacts (transcripts, raw API responses).
CACHE_DIR=./.cache

# Shared secret guarding admin-only API routes — REQUIRED for the API to boot.
# Set to any strong secret value (e.g. openssl rand -hex 32).
ADMIN_API_KEY=

# Base URL the web app uses to reach the API in the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Override the reference video the daily caption smoke-test exercises (default: 19l5OI_8ljQ).
# SMOKE_TEST_VIDEO_ID=19l5OI_8ljQ
# SMOKE_TEST_MIN_SEGMENTS=50
# SMOKE_TEST_MIN_WORDS=500
# SMOKE_TEST_MIN_COVERAGE_PCT=60

# OpenAI key for embedding generation and LLM enrichment; required for --embed, mode=semantic, and --enrich.
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# ENRICHMENT_MODEL=gpt-4o-mini

# Token-budget cap for self-service ingestion requests. Ingest pauses for admin
# approval once this many transcript tokens have been processed. Must be set to
# the same value on both the API and the worker.
# DEFAULT: 750000 (api) / 250000 fallback (worker local dev seed)
# LIMITED_INGEST_TOKEN_CAP=750000

# ── Google OAuth (user accounts) ────────────────────────────────────────────
# Obtained from Google Cloud Console → APIs & Services → Credentials.
# REQUIRED for the auth flow to work; see the "User Accounts & Google Sign-In" brief.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback

# Shared 32-byte secret for signing the OAuth state cookie (openssl rand -hex 32).
COOKIE_SECRET=

# Base URL of the web app — used for return_to validation and redirects after login.
WEB_BASE_URL=http://localhost:3000

# ── Notifications ───────────────────────────────────────────────────────────
# Optional. With SMTP_HOST unset, packages/notifications falls back to a
# log-only sender so local dev flows keep working.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=no-reply@sermonseek.ai
# Admin recipient for awaiting_approval / failed / complete notifications.
# ADMIN_EMAIL=

# ── Admin panel ─────────────────────────────────────────────────────────────
# External port the admin panel listens on (TLS-terminated at the proxy,
# proxied to internal admin:3000). Firewall to known IPs in production.
ADMIN_PORT=8443

# Base URL of the admin app (port 3002 in dev, 8443 in prod).
# Consumed by the API's return_to allowlist and by the admin app for self-links.
ADMIN_BASE_URL=http://localhost:3002

# Comma-separated Google emails auto-promoted to is_admin=true on first sign-in.
# Removing an email here does NOT demote — only adding it triggers promotion.
ADMIN_ALLOWED_EMAILS=

# Server-side URL the admin app uses to reach the API (compose: http://api:3001).
ADMIN_API_URL=http://localhost:3001
