# YouTube Data API v3 key — used by the worker to fetch sermon metadata.
YOUTUBE_API_KEY=

# Postgres connection string for local development (matches docker-compose default in C2).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sermon_search

# Local on-disk cache directory for worker artifacts (transcripts, raw API responses).
CACHE_DIR=./.cache

# Shared secret guarding admin-only API routes.
ADMIN_API_KEY=

# Base URL the web app uses to reach the API in the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
